<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan is required, not optional: there is no GLES fallback by design (D-003). -->
    <uses-feature android:name="android.hardware.vulkan.version"
                  android:version="0x400003"
                  android:required="true" />

    <application
        android:label="Trussline Spike A"
        android:hasCode="false"
        android:allowBackup="false">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout">

            <meta-data android:name="android.app.lib_name" android:value="spikea" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
